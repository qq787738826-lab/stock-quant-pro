{
  "name": "stock-quant-desktop",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "dev": "npm run compile && electron .",
    "test": "npm run compile && node --test tests/*.test.mjs",
    "build": "npm run compile && node scripts/write-runtime-config.mjs && electron-builder --win nsis",
    "build:dir": "npm run compile && node scripts/write-runtime-config.mjs && electron-builder --win dir"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.7.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.stockquant.pro",
    "productName": "Stock Quant Pro",
    "artifactName": "Stock Quant Pro Setup.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist-electron/**/*",
      "assets/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "executableName": "Stock Quant Pro"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Stock Quant Pro",
      "uninstallDisplayName": "Stock Quant Pro"
    }
  }
}
